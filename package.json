{
  "name": "change-order-recovery-audit",
  "version": "1.0.1",
  "private": true,
  "description": "A read-only Claude Desktop audit of change-order exposure in one local project folder.",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "pack": "npx --yes @anthropic-ai/mcpb pack",
    "package:check": "node scripts/package-check.mjs",
    "start": "node dist/src/index.js",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run build && npm test"
  },
  "engines": {
    "node": ">=20.16"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "exceljs": "4.4.0",
    "mammoth": "1.12.1",
    "pdf-parse": "2.4.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "docx": "9.5.1",
    "pdf-lib": "1.17.1",
    "tsx": "4.20.6",
    "typescript": "5.9.2"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
